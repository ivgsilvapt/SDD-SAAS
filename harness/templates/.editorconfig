# Harness Template: EditorConfig
# Garante estilo consistente entre editores e desenvolvedores.
# Copiar para raiz do projeto.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# JavaScript / TypeScript / JSON / YAML / Markdown
[*.{js,jsx,mjs,cjs,ts,tsx,json,jsonc,yaml,yml,md,mdx,css,scss,html}]
indent_style = space
indent_size = 2

# Python
[*.py]
indent_style = space
indent_size = 4
max_line_length = 120

# Go
[*.go]
indent_style = tab
indent_size = 4

# Makefile (obrigatório usar tabs)
[Makefile]
indent_style = tab

# Terraform
[*.{tf,tfvars}]
indent_style = space
indent_size = 2

# Shell scripts
[*.sh]
indent_style = space
indent_size = 2

# Ignorar arquivos gerados
[{package-lock.json,*.lock,dist/**,build/**}]
insert_final_newline = false
trim_trailing_whitespace = false
